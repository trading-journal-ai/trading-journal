//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// LEVEL MAP ASSISTANT
//
// Speeds up the level-MAPPING pass on a daily / weekly / monthly chart:
//   1. Shades the highest-volume candles in a lookback window as zones.
//      ("The most business was done here, so this is where supply sits.")
//   2. Draws pivots that price has never closed through (unbroken levels).
//
// These are SUGGESTIONS TO MARK, not marks. Draw the levels you believe in —
// your drawn levels remain the source of truth (see docs/coach/LEVELS.md).
//
// Not for execution. The 1m/5m execution chart is session-levels.pine.
// Spec: docs/product/PINE_SETUP_INDICATOR.md
// ─────────────────────────────────────────────────────────────────────────────
indicator("Level Map Assistant", overlay = true, max_boxes_count = 100, max_lines_count = 200, max_labels_count = 300)

// ═══ VOLUME ZONES ═══════════════════════════════════════════════════════════
gZone       = "High-volume zones"
inLookback  = input.int(250,  "Lookback bars",             minval = 20, maxval = 3000, group = gZone, tooltip = "How far back to search for the highest-volume candles.")
inTopN      = input.int(5,    "Zones to draw",             minval = 1,  maxval = 20,   group = gZone)
inUseBody   = input.bool(false, "Use candle body only",    group = gZone, tooltip = "Off = full high/low range (wider zone). On = open/close body (tighter).")
inExtend    = input.int(40,   "Extend zones right (bars)", minval = 0,  maxval = 500,  group = gZone)
inZoneFill  = input.color(color.new(color.orange, 82), "Zone fill",   group = gZone)
inZoneEdge  = input.color(color.new(color.orange, 35), "Zone border", group = gZone)
inZoneLabel = input.bool(true, "Label zones (rank + volume)", group = gZone)

// ═══ UNBROKEN PIVOTS ════════════════════════════════════════════════════════
gPiv        = "Unbroken pivots"
inShowPiv   = input.bool(true, "Show unbroken pivots", group = gPiv, tooltip = "Pivot highs price has never closed above, and pivot lows it has never closed below.")
inPivLen    = input.int(5, "Pivot strength (bars each side)", minval = 2, maxval = 50, group = gPiv)
inPivKeep   = input.int(6, "Max pivots per side",             minval = 1, maxval = 30, group = gPiv)
inPivHiCol  = input.color(color.new(color.red, 20),   "Unbroken high", group = gPiv)
inPivLoCol  = input.color(color.new(color.green, 20), "Unbroken low",  group = gPiv)
inPivLabel  = input.bool(true, "Label pivots with price", group = gPiv)

// ═══ HELPERS ════════════════════════════════════════════════════════════════
fmtVol(float v) =>
    v >= 1000000000 ? str.tostring(v / 1000000000, "#.##") + "B" : v >= 1000000 ? str.tostring(v / 1000000, "#.##") + "M" : v >= 1000 ? str.tostring(v / 1000, "#.#") + "K" : str.tostring(v, "#")

// ═══ HIGH-VOLUME ZONES ══════════════════════════════════════════════════════
// Recomputed on the last bar only: cheap, and always reflects current settings.

var box[]   zoneBoxes  = array.new<box>()
var label[] zoneLabels = array.new<label>()

if barstate.islast
    // Clear the previous draw so redraws don't leak objects.
    if array.size(zoneBoxes) > 0
        for b in zoneBoxes
            box.delete(b)
        array.clear(zoneBoxes)
    if array.size(zoneLabels) > 0
        for l in zoneLabels
            label.delete(l)
        array.clear(zoneLabels)

    vols  = array.new<float>()
    tops  = array.new<float>()
    bots  = array.new<float>()
    backs = array.new<int>()

    // Offsets beyond available history return na and are skipped, so the four
    // arrays stay index-aligned.
    for i = 0 to inLookback - 1
        if not na(volume[i]) and not na(high[i])
            array.push(vols,  volume[i])
            array.push(tops,  inUseBody ? math.max(open[i], close[i]) : high[i])
            array.push(bots,  inUseBody ? math.min(open[i], close[i]) : low[i])
            array.push(backs, i)

    if array.size(vols) > 0
        ranks = array.sort_indices(vols, order.descending)
        drawN = math.min(inTopN, array.size(ranks))

        for k = 0 to drawN - 1
            pos   = array.get(ranks, k)
            zTop  = array.get(tops, pos)
            zBot  = array.get(bots, pos)
            zVol  = array.get(vols, pos)
            zBack = array.get(backs, pos)

            array.push(zoneBoxes, box.new(bar_index - zBack, zTop, bar_index + inExtend, zBot, border_color = inZoneEdge, border_width = 1, bgcolor = inZoneFill))

            if inZoneLabel
                array.push(zoneLabels, label.new(bar_index + inExtend, zTop, "#" + str.tostring(k + 1) + "  " + fmtVol(zVol), style = label.style_label_left, color = color.new(color.orange, 75), textcolor = color.white, size = size.small))

// ═══ UNBROKEN PIVOTS ════════════════════════════════════════════════════════
// Tracked causally as bars arrive: a pivot is dropped the moment price closes
// through it, so whatever remains has genuinely never been taken out.

var float[] phLevel = array.new<float>()
var int[]   phBar   = array.new<int>()
var float[] plLevel = array.new<float>()
var int[]   plBar   = array.new<int>()

if inShowPiv
    ph = ta.pivothigh(inPivLen, inPivLen)
    pl = ta.pivotlow(inPivLen, inPivLen)

    if not na(ph)
        array.push(phLevel, ph)
        array.push(phBar, bar_index - inPivLen)
    if not na(pl)
        array.push(plLevel, pl)
        array.push(plBar, bar_index - inPivLen)

    // Drop levels price has closed through. The index only advances when the
    // current element survives, so a removal never skips its neighbour.
    int i = 0
    while i < array.size(phLevel)
        if close > array.get(phLevel, i)
            array.remove(phLevel, i)
            array.remove(phBar, i)
        else
            i := i + 1

    int j = 0
    while j < array.size(plLevel)
        if close < array.get(plLevel, j)
            array.remove(plLevel, j)
            array.remove(plBar, j)
        else
            j := j + 1

    // Keep only the most recent N per side.
    while array.size(phLevel) > inPivKeep
        array.shift(phLevel)
        array.shift(phBar)
    while array.size(plLevel) > inPivKeep
        array.shift(plLevel)
        array.shift(plBar)

var line[]  pivLines  = array.new<line>()
var label[] pivLabels = array.new<label>()

if barstate.islast
    if array.size(pivLines) > 0
        for ln in pivLines
            line.delete(ln)
        array.clear(pivLines)
    if array.size(pivLabels) > 0
        for l in pivLabels
            label.delete(l)
        array.clear(pivLabels)

    if inShowPiv
        if array.size(phLevel) > 0
            for i = 0 to array.size(phLevel) - 1
                lv = array.get(phLevel, i)
                array.push(pivLines, line.new(array.get(phBar, i), lv, bar_index + inExtend, lv, color = inPivHiCol, width = 1, style = line.style_dashed))
                if inPivLabel
                    array.push(pivLabels, label.new(bar_index + inExtend, lv, str.tostring(lv, format.mintick), style = label.style_label_left, color = color.new(color.red, 80), textcolor = inPivHiCol, size = size.small))

        if array.size(plLevel) > 0
            for i = 0 to array.size(plLevel) - 1
                lv = array.get(plLevel, i)
                array.push(pivLines, line.new(array.get(plBar, i), lv, bar_index + inExtend, lv, color = inPivLoCol, width = 1, style = line.style_dashed))
                if inPivLabel
                    array.push(pivLabels, label.new(bar_index + inExtend, lv, str.tostring(lv, format.mintick), style = label.style_label_left, color = color.new(color.green, 80), textcolor = inPivLoCol, size = size.small))
